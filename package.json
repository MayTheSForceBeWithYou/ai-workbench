{
  "name": "ai-workbench",
  "version": "0.1.0",
  "description": "Local CLI dashboard for tracking and optimizing AI coding tool usage",
  "type": "module",
  "bin": {
    "aiw": "./dist/cli.js"
  },
  "scripts": {
    "dev": "NODE_NO_WARNINGS=1 tsx src/cli.ts",
    "build": "tsc",
    "start": "NODE_NO_WARNINGS=1 node dist/cli.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.15.7",
    "typescript": "^5.4.5",
    "vitest": "^4.1.8"
  }
}
